{
  "name": "@printer/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned JSON Schema contracts and generated TypeScript types for Printer jobs and results.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "schemas"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
