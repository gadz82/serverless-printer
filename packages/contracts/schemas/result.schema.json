{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printer.dev/contracts/1.0.0/result.schema.json",
  "title": "PrintResult",
  "description": "The result of one print job, delivered on the callback channel chosen by the caller.",
  "oneOf": [
    {
      "$ref": "#/$defs/printSuccessResult"
    },
    {
      "$ref": "#/$defs/printFailureResult"
    }
  ],
  "$defs": {
    "printSuccessResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "printId",
        "refId",
        "sha256",
        "sizeBytes",
        "pdfA",
        "template",
        "renderedAt"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "const": true
        },
        "printId": {
          "description": "UUIDv5 derived from the Printer namespace and the inbound SQS message id.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "refId": {
          "description": "The submitted refId, echoed unchanged.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "additionalProperties": {}
            }
          ]
        },
        "printing": {
          "description": "HTTPS presigned GET URL for the stored PDF. Omitted for the s3 channel.",
          "type": "string",
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/[^\\s?#]*\\?(?=[^\\s]*X-Amz-Signature=)[^\\s]+$"
        },
        "printingExpiresAt": {
          "description": "RFC 3339 date-time at which the presigned GET URL expires.",
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "sha256": {
          "description": "Lower-case SHA-256 hex digest of the stored PDF bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "description": "Size of the stored PDF in bytes.",
          "type": "integer",
          "minimum": 1
        },
        "pdfA": {
          "description": "null for a standard PDF, otherwise the PDF/A level that was requested.",
          "enum": [
            null,
            "PDF/A-1b",
            "PDF/A-1a",
            "PDF/A-2b",
            "PDF/A-2u",
            "PDF/A-2a",
            "PDF/A-3b",
            "PDF/A-3u",
            "PDF/A-3a"
          ]
        },
        "template": {
          "$ref": "#/$defs/resultTemplate"
        },
        "renderedAt": {
          "description": "RFC 3339 date-time when rendering completed.",
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        }
      },
      "dependentRequired": {
        "printing": ["printingExpiresAt"],
        "printingExpiresAt": ["printing"]
      }
    },
    "printFailureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "printId", "refId", "template", "error", "failedAt"],
      "properties": {
        "success": {
          "type": "boolean",
          "const": false
        },
        "printId": {
          "description": "UUIDv5 derived from the Printer namespace and the inbound SQS message id.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "refId": {
          "description": "The submitted refId, echoed unchanged.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "additionalProperties": {}
            }
          ]
        },
        "template": {
          "description": "Template metadata, or null when the template could not be resolved.",
          "anyOf": [
            {
              "$ref": "#/$defs/resultTemplate"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/printError"
        },
        "failedAt": {
          "description": "RFC 3339 date-time when the job failed.",
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        }
      }
    },
    "resultTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "contentHash", "release"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "slug": {
          "type": "string",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^_smoke$"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,63}$"
            }
          ]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "printError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "attempts"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_MESSAGE",
            "PDFA_LEVEL_NOT_ALLOWED",
            "TEMPLATE_NOT_FOUND",
            "CALLBACK_NOT_ALLOWED",
            "TEMPLATE_RENDER_FAILED",
            "PDFA_CONVERSION_FAILED",
            "PDF_RENDER_FAILED",
            "DELIVERY_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "attempts": {
          "description": "Receive count for the inbound message; at least 1.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": ["PDF_RENDER_FAILED", "DELIVERY_FAILED"]
              }
            },
            "required": ["code"]
          },
          "then": {
            "type": "object",
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_MESSAGE",
                  "PDFA_LEVEL_NOT_ALLOWED",
                  "TEMPLATE_NOT_FOUND",
                  "CALLBACK_NOT_ALLOWED",
                  "TEMPLATE_RENDER_FAILED",
                  "PDFA_CONVERSION_FAILED"
                ]
              }
            },
            "required": ["code"]
          },
          "then": {
            "type": "object",
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
