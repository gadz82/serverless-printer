# Copy this file to infra/terraform.tfvars and replace the example values.
# Keep it out of commits. In CI, the release workflow materializes the same
# content from the non-secret TF_VARS repository variable.
# The release workflow supplies release and artifacts_bucket with -var, so the
# values here only affect manual applies and plans.

name_prefix = "printer"
region      = "eu-central-1"

# Release label whose render-worker.zip is deployed from the artifacts bucket.
# The release workflow overrides this with -var release=<release>.
release = "dev"

# Bootstrap outputs. The defaults (<name_prefix>-artifacts and the
# <name_prefix>-deploy role) are used when these are omitted, but an operator
# should still verify them against `terraform -chdir=infra/bootstrap output`.
artifacts_bucket = "printer-artifacts"
deploy_role_arn  = "arn:aws:iam::123456789012:role/printer-deploy"

# Caller and worker roles. The default creates both roles. Set a mode to
# "existing" to use a provided ARN instead; provided roles are not modified.
# Existing caller roles may be in another account; existing worker roles must
# be in this account and trust lambda.amazonaws.com.
caller_role_mode              = "create"
caller_role_arn               = null
caller_trusted_principal_arns = [] # Empty trusts the deployer account root.
worker_role_mode              = "create"
worker_role_arn               = null

# Who may send jobs to the jobs queue. The generated or provided caller role is
# always allowed. The release smoke sends through the deploy role's IAM policy,
# which is not a queue-policy exception.
allowed_sender_account_ids    = ["123456789012"]
allowed_sender_principal_arns = []
# organization_id             = "o-a1b2c3d4e5"

# Explicit result targets the worker may publish to: SQS queue ARNs, Lambda
# function ARNs or EventBridge event bus ARNs. Wildcards and the jobs queue ARN
# are rejected. The <name_prefix>-smoke-results queue is always added.
callback_target_arns = [
  "arn:aws:sqs:eu-central-1:123456789012:printer-callbacks",
  # "arn:aws:lambda:eu-central-1:123456789012:function:printer-results",
  # "arn:aws:events:eu-central-1:123456789012:event-bus/printer-results",
]

# HTTPS host patterns allowed for http callbacks and ping URLs.
callback_allowlist = [
  "https://callbacks.example.com",
  "https://*.example.net",
]

handlebars_mode = "lenient"
# Defaults to all eight levels; set a subset to restrict PDF/A requests. The
# setting only takes effect once the P-202/P-204/P-209 PDF/A work is deployed.
pdfa_allowed_levels = [
  "PDF/A-1b",
  "PDF/A-1a",
  "PDF/A-2b",
  "PDF/A-2u",
  "PDF/A-2a",
  "PDF/A-3b",
  "PDF/A-3u",
  "PDF/A-3a",
]

event_source        = "printer"
presign_ttl_seconds = 900
max_receive_count   = 5
batch_size          = 5
maximum_concurrency = 10
worker_memory_size  = 1536
# reserved_concurrency = 5

enable_alarms       = false
alarm_sns_topic_arn = null
log_retention_days  = 30

# Network. "none" is the default and creates no VPC resources; the worker
# reaches AWS and callbacks over the AWS network and the internet.
vpc_mode = "none"

# create mode: a new VPC with private subnets, an S3 gateway endpoint and
# SQS/Lambda/Events interface endpoints. NAT is off by default.
vpc_cidr               = "10.0.0.0/16"
az_count               = 2
availability_zones     = [] # Empty uses the region's enabled availability zones.
enable_nat_gateway     = false
enable_s3_endpoint     = true
enable_sqs_endpoint    = true
enable_lambda_endpoint = true
enable_events_endpoint = true

# lookup mode: exactly one of vpc_id or vpc_tags, and exactly one of
# subnet_ids or subnet_tags. Leave empty for none/create.
vpc_id      = null
vpc_tags    = {}
subnet_ids  = []
subnet_tags = {}
# Optional existing worker security groups in lookup mode; empty creates a
# managed security group with DNS/HTTPS egress.
worker_security_group_ids = []

# Example lookup configuration:
# vpc_mode    = "lookup"
# vpc_id      = "vpc-0123456789abcdef0"
# subnet_ids  = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]
# vpc_tags    = {}
# subnet_tags = {}

tags = {
  # Keep Project equal to name_prefix: the bootstrap deploy role's KMS identity
  # policy uses aws:ResourceTag/Project = name_prefix.
  Project = "printer"
}
