{
  "name": "@printer/render-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker that turns SQS print jobs into rendered PDFs, PDF/A archives and callback results.",
  "main": "./src/handler.ts",
  "types": "./src/handler.ts",
  "exports": {
    ".": {
      "types": "./src/handler.ts",
      "import": "./src/handler.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "catalog:",
    "@aws-sdk/client-lambda": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@printer/contracts": "workspace:*",
    "@printer/domain": "workspace:*",
    "@printer/template-engine": "workspace:*",
    "@sparticuz/chromium": "catalog:",
    "pdf-lib": "catalog:",
    "puppeteer-core": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
